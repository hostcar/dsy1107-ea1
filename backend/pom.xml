<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>cl.duoc.dsy1107</groupId>
    <artifactId>ae1</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>ae1-backend</name>
    <description>DSY1107 EA1 - backend que queda detras del API Manager: proxy con cache de mindicador.cl</description>

    <properties>
        <!-- Tiene que coincidir con la plataforma de Beanstalk
             (terraform/beanstalk.tf: "... running Corretto 21"). Compilar con
             una version mayor que la de la plataforma revienta en el arranque
             con UnsupportedClassVersionError. Es la lamina 7 de la guia 1.3.8.
             El JDK local puede ser mayor: Maven compila apuntando a 21. -->
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- starter-web y no starter a secas: esto expone HTTP y trae el RestClient
             con el que se consume mindicador.cl. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- /actuator/health es el health check del entorno de Beanstalk
             (lamina 16 de la guia 1.3.8: "Application Healthcheck URL"). Sin
             esto el entorno pide "/" y recibe 404: queda Severe con la app
             perfectamente viva. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- En Spring Boot 4 el RestClient.Builder autoconfigurado ya no viene
             dentro de starter-web: vive en su propio modulo. Es el cliente con
             el que se llama a mindicador.cl. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>

        <!-- Solo genera el autocompletado de application.yml para las propiedades
             backend.*. No viaja en el jar final. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ================================================================
             La persistencia: el CRUD de /productos sobre el PostgreSQL de
             terraform/rds.tf.

             OJO CON EL EFECTO SECUNDARIO: en cuanto esta dependencia entra al
             classpath, Spring exige un DataSource para arrancar. Sin el, el
             contexto no levanta y se caen tambien las pruebas que no tienen
             nada que ver con la base.

             Lo resuelve H2 mas abajo: como application.yml NO fija una URL
             (llega del entorno), en las pruebas no hay ninguna configurada y
             Spring Boot levanta solo una base en memoria.
             ================================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- @Valid sobre el cuerpo de POST y PUT. Sin esto las anotaciones
             @NotBlank y @Positive se compilan pero no las mira nadie: el
             validador no esta y la peticion pasa igual. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- runtime y no compile: el codigo no nombra ni una clase del driver,
             solo la URL jdbc:postgresql. Que no este disponible al compilar es
             la garantia de que sigue siendo asi. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- El esquema, versionado y en el repositorio, en vez de dejar que
             Hibernate lo invente con ddl-auto. Contra una base real eso ultimo
             es exactamente lo que no se hace: un rename de campo se convierte
             en una columna nueva y los datos viejos quedan huerfanos sin que
             nadie se entere. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- Desde Flyway 10 los motores grandes van en modulos aparte:
             flyway-core no sabe hablar PostgreSQL sin esto. (H2, en cambio, si
             viene dentro de flyway-core: no existe un flyway-database-h2.) -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- LA PIEZA QUE NO SE VE VENIR. Spring Boot 4 partio las
             autoconfiguraciones en modulos por tecnologia, y la de Flyway ya no
             viaja dentro de spring-boot-autoconfigure. Con flyway-core solo, la
             libreria queda en el classpath y NADIE LA INVOCA: no hay error, no
             hay log, simplemente las migraciones no corren y la primera senal
             es un "Schema validation: missing table" que apunta a Hibernate y
             no a Flyway. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- La base de las pruebas: en memoria, una por ejecucion. Las pruebas
             no tocan el RDS ni necesitan Docker, y aun asi corren la migracion
             de verdad, porque V1__producto.sql esta escrita en SQL portable. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Boot 4 partio el modulo de test: @WebMvcTest y MockMvc ya no
             vienen en starter-test, hay que pedirlos aparte. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- El jar se llama siempre backend.jar, sin la version en el nombre.
             Asi el Procfile ("web: java -jar backend.jar") no cambia nunca y el
             script de empaquetado tampoco. -->
        <finalName>backend</finalName>

        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
